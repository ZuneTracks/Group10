<Application
    x:Class="Group10.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="Group10BlueBrush" Color="#1479B8" />
        <SolidColorBrush x:Key="Group10DarkBlueBrush" Color="#0B5C8E" />
        <SolidColorBrush x:Key="Group10CanvasBrush" Color="#F3F6F8" />
        <SolidColorBrush x:Key="Group10DividerBrush" Color="#DDE5EA" />
        <Style x:Key="CommandGlyphButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="MinWidth" Value="44" />
            <Setter Property="MinHeight" Value="44" />
        </Style>
    </Application.Resources>
</Application>
